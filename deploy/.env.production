# Chat-Quant production backend environment.

DOMAIN=chatq.nanbende.com
CHATQ_ENV=production
CHATQ_LOG_LEVEL=INFO
CHATQ_LOG_FORMAT=json
CHATQ_ACCESS_LOG_ENABLED=true

CHATQ_DATABASE_PATH=data/chat-quant.db
PROJECT_HOME=data/projects
CHATQ_CLAUDE_AGENT_CWD=/opt/chat-quant
AGENT_SKILL_PLUGIN_DIR=/opt/chat-quant/plugin
AGENT_SKILL_PLUGIN_NAME=chat-quant

CHATQ_API_CORS_ORIGINS=["https://chatq.nanbende.com"]
CHATQ_DEFAULT_USER_ID=local_user
CHATQ_DEFAULT_PROJECT_ID=local_project

# Fill these when enabling the agent runtime.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4
