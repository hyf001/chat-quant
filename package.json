{
  "name": "chat-quant",
  "private": true,
  "scripts": {
    "dev:start": "bash scripts/dev-start.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "dev:api": "uv run --project apps/api uvicorn app.main:app --reload --app-dir apps/api",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:desktop": "npm --prefix apps/desktop run dev",
    "build:desktop": "npm --prefix apps/desktop run build",
    "pack:desktop": "npm --prefix apps/desktop run pack",
    "lint:api": "uv run --project apps/api ruff check apps/api/app",
    "lint:web": "npm --prefix apps/web run lint"
  }
}
