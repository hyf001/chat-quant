{
  "name": "chat-quant",
  "private": true,
  "scripts": {
    "dev:web-start": "bash scripts/dev-web-start.sh",
    "dev:web-stop": "bash scripts/dev-web-stop.sh",
    "dev:desktop-start": "bash scripts/dev-desktop-start.sh",
    "dev:desktop-stop": "bash scripts/dev-desktop-stop.sh",
    "build:desktop": "npm --prefix apps/desktop run build",
    "pack:desktop": "npm --prefix apps/desktop run pack",
    "lint:api": "UV_CACHE_DIR=${TMPDIR:-/tmp}/chat-quant-uv-cache uv run --project apps/api ruff check apps/api/app",
    "lint:web": "npm --prefix apps/web run lint"
  }
}
