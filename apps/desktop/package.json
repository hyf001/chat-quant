{
  "name": "chat-quant-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build:web": "npm --prefix ../web run build",
    "build:sidecar": "bash scripts/build-api-sidecar.sh",
    "build": "npm run build:web",
    "dev": "npm run build:web && electron .",
    "pack": "npm run build:web && electron-builder --dir",
    "dist": "npm run build:web && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chatquant.desktop",
    "productName": "Chat Quant",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sidecars",
        "to": "sidecars",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.finance"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Finance"
    }
  }
}
